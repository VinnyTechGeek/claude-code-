<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monitor de Uso</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root{
    --bg:#0f1115; --card:#171a21; --border:#262a34;
    --text:#e8e9ed; --muted:#8b8f9a;
    --green:#4ade80; --yellow:#facc15; --red:#f87171; --blue:#60a5fa;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    background:var(--bg); color:var(--text); padding:16px; max-width:520px; margin:0 auto;
  }
  h1{font-size:19px; margin:4px 0 16px; font-weight:600;}
  .card{
    background:var(--card); border:1px solid var(--border); border-radius:14px;
    padding:16px; margin-bottom:12px;
  }
  .row{display:flex; justify-content:space-between; align-items:center; gap:8px;}
  .label{color:var(--muted); font-size:13px;}
  .big{font-size:26px; font-weight:700; margin-top:4px;}
  .status{
    display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; margin-top:6px;
  }
  .ok{background:rgba(74,222,128,.15); color:var(--green);}
  .warn{background:rgba(250,204,21,.15); color:var(--yellow);}
  .bad{background:rgba(248,113,113,.15); color:var(--red);}
  .grid2{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .mini{font-size:12px; color:var(--muted);}
  .miniVal{font-size:16px; font-weight:600; margin-top:2px;}
  form{display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;}
  input{
    background:#0f1115; border:1px solid var(--border); color:var(--text);
    padding:9px 10px; border-radius:8px; font-size:14px; flex:1; min-width:90px;
  }
  button{
    background:var(--blue); color:#08101d; border:none; padding:9px 14px;
    border-radius:8px; font-weight:600; font-size:14px; cursor:pointer;
  }
  button.secondary{background:#262a34; color:var(--text);}
  .entries{max-height:180px; overflow-y:auto; margin-top:10px;}
  .entry{display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid var(--border); font-size:13px;}
  .entry button{background:none; color:var(--red); padding:2px 6px; font-size:12px;}
  canvas{max-height:200px;}
  .settingsRow{display:flex; gap:8px; align-items:center; margin-top:8px;}
  .settingsRow input{flex:1;}
  .footnote{font-size:11px; color:var(--muted); margin-top:10px; text-align:center;}
</style>
</head>
<body>

<h1>💸 Monitor de uso mensal</h1>

<div class="card" id="budgetCard">
  <div class="row">
    <div>
      <div class="label">Orçamento do mês</div>
      <div class="big" id="budgetVal">--</div>
    </div>
    <button class="secondary" onclick="toggleSettings()">Editar</button>
  </div>
  <div id="settingsBox" style="display:none;">
    <div class="settingsRow">
      <input type="number" id="budgetInput" placeholder="Orçamento (US$)" step="0.01">
      <button onclick="saveBudget()">Salvar</button>
    </div>
  </div>
</div>

<div class="card">
  <div class="row">
    <div>
      <div class="label">Gasto acumulado</div>
      <div class="big" id="spentVal">US$ 0,00</div>
      <div class="status" id="statusBadge">--</div>
    </div>
    <div style="text-align:right;">
      <div class="label">Restante</div>
      <div class="big" id="remainingVal" style="font-size:20px;">--</div>
    </div>
  </div>

  <div class="grid2" style="margin-top:14px;">
    <div>
      <div class="mini">Ritmo ideal / dia</div>
      <div class="miniVal" id="idealDaily">--</div>
    </div>
    <div>
      <div class="mini">Ritmo real médio / dia</div>
      <div class="miniVal" id="realDaily">--</div>
    </div>
    <div>
      <div class="mini">Devia ter gasto até hoje</div>
      <div class="miniVal" id="idealSoFar">--</div>
    </div>
    <div>
      <div class="mini">Disponível p/ restante do mês / dia</div>
      <div class="miniVal" id="dailyAllowanceLeft">--</div>
    </div>
  </div>

  <div class="footnote" id="dayCounter">--</div>
</div>

<div class="card">
  <div class="label" style="margin-bottom:6px;">Projeção até o fim do mês</div>
  <div class="row">
    <div class="mini">Se continuar nesse ritmo, você fecha o mês em:</div>
  </div>
  <div class="big" id="projectionVal" style="font-size:22px;">--</div>
</div>

<div class="card">
  <div class="label" style="margin-bottom:8px;">Real vs. ideal (acumulado)</div>
  <canvas id="chart"></canvas>
</div>

<div class="card">
  <div class="label">Registrar total acumulado do dia</div>
  <form onsubmit="addEntry(event)">
    <input type="date" id="entryDate" required>
    <input type="number" id="entryAmount" placeholder="US$ acumulado até esse dia" step="0.01" required>
    <button type="submit">Adicionar</button>
  </form>
  <div class="entries" id="entriesList"></div>
</div>

<div class="footnote">Dados salvos só neste dispositivo/conta, ninguém mais vê.</div>

<script>
const STORAGE_KEY = 'usage-monitor-data';
let state = { budget: 200, entries: {} }; // entries: {'2026-08-08': 45.47}
let chart = null;

function todayISO(){
  const d = new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}

function currentMonthKey(){
  return todayISO().slice(0,7); // YYYY-MM
}

function daysInMonth(year, month){ // month 1-12
  return new Date(year, month, 0).getDate();
}

async function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw) state = JSON.parse(raw);
  }catch(e){
    console.log('sem dado salvo ainda, usando padrão');
  }
  if(!state.entries) state.entries = {};
  if(!state.budget) state.budget = 200;
  render();
}

async function saveState(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }catch(e){
    console.error('erro ao salvar', e);
  }
}

function toggleSettings(){
  const box = document.getElementById('settingsBox');
  const input = document.getElementById('budgetInput');
  input.value = state.budget;
  box.style.display = box.style.display === 'none' ? 'block' : 'none';
}

async function saveBudget(){
  const v = parseFloat(document.getElementById('budgetInput').value);
  if(!isNaN(v) && v > 0){
    state.budget = v;
    await saveState();
    render();
    toggleSettings();
  }
}

async function addEntry(ev){
  ev.preventDefault();
  const date = document.getElementById('entryDate').value;
  const amount = parseFloat(document.getElementById('entryAmount').value);
  if(date && !isNaN(amount)){
    state.entries[date] = amount;
    await saveState();
    document.getElementById('entryAmount').value = '';
    render();
  }
}

async function removeEntry(date){
  delete state.entries[date];
  await saveState();
  render();
}

function fmt(v){
  return 'US$ ' + v.toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2});
}

function render(){
  document.getElementById('entryDate').value = todayISO();
  document.getElementById('budgetVal').textContent = fmt(state.budget);

  const monthKey = currentMonthKey();
  const [year, month] = monthKey.split('-').map(Number);
  const totalDays = daysInMonth(year, month);
  const todayDay = new Date().getDate();

  // entries do mês atual, ordenadas
  const monthEntries = Object.entries(state.entries)
    .filter(([d]) => d.startsWith(monthKey))
    .sort((a,b) => a[0].localeCompare(b[0]));

  // o valor lançado já é o acumulado até aquele dia — pega o mais recente
  const lastEntry = monthEntries.length ? monthEntries[monthEntries.length - 1] : null;
  const totalSpent = lastEntry ? lastEntry[1] : 0;
  const lastEntryDay = lastEntry ? Number(lastEntry[0].split('-')[2]) : todayDay;
  const remaining = state.budget - totalSpent;

  const idealDailyRate = state.budget / totalDays;
  const idealSoFar = idealDailyRate * todayDay;
  const diff = totalSpent - idealSoFar;

  const realDailyAvg = totalSpent / Math.max(lastEntryDay, 1);

  const daysRemaining = Math.max(totalDays - todayDay, 1);
  const dailyAllowanceLeft = remaining / daysRemaining;

  const projectedTotal = realDailyAvg * totalDays;

  document.getElementById('spentVal').textContent = fmt(totalSpent);
  document.getElementById('remainingVal').textContent = fmt(remaining);
  document.getElementById('idealDaily').textContent = fmt(idealDailyRate);
  document.getElementById('realDaily').textContent = fmt(realDailyAvg);
  document.getElementById('idealSoFar').textContent = fmt(idealSoFar);
  document.getElementById('dailyAllowanceLeft').textContent = fmt(dailyAllowanceLeft);
  document.getElementById('dayCounter').textContent =
    `Dia ${todayDay} de ${totalDays} do mês · ${daysRemaining} dia(s) restante(s)`;

  const badge = document.getElementById('statusBadge');
  if(diff > state.budget*0.03){
    badge.textContent = `Acima do ritmo (+${fmt(diff)})`;
    badge.className = 'status bad';
  } else if(diff < -state.budget*0.03){
    badge.textContent = `Abaixo do ritmo (${fmt(diff)})`;
    badge.className = 'status ok';
  } else {
    badge.textContent = 'No ritmo';
    badge.className = 'status warn';
  }

  const projVal = document.getElementById('projectionVal');
  projVal.textContent = fmt(projectedTotal);
  projVal.style.color = projectedTotal > state.budget ? 'var(--red)' : 'var(--green)';

  // lista de entradas
  const list = document.getElementById('entriesList');
  list.innerHTML = '';
  monthEntries.slice().reverse().forEach(([date, amount]) => {
    const div = document.createElement('div');
    div.className = 'entry';
    const d = new Date(date+'T00:00:00');
    const dstr = d.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit'});
    div.innerHTML = `<span>${dstr} — ${fmt(amount)}</span><button onclick="removeEntry('${date}')">remover</button>`;
    list.appendChild(div);
  });

  renderChart(monthEntries, idealDailyRate, totalDays);
}

function renderChart(monthEntries, idealDailyRate, totalDays){
  const labels = [];
  const idealLine = [];
  const realLine = [];
  let lastKnown = null;
  const entryMap = Object.fromEntries(monthEntries);
  const monthKey = currentMonthKey();
  const todayDay = new Date().getDate();

  for(let day = 1; day <= totalDays; day++){
    const dateStr = monthKey + '-' + String(day).padStart(2,'0');
    labels.push(day);
    idealLine.push(+(idealDailyRate * day).toFixed(2));
    if(day <= todayDay){
      if(entryMap[dateStr] !== undefined) lastKnown = entryMap[dateStr];
      realLine.push(lastKnown === null ? null : +lastKnown.toFixed(2));
    } else {
      realLine.push(null);
    }
  }

  const ctx = document.getElementById('chart').getContext('2d');
  if(chart) chart.destroy();
  chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: 'Ideal (linear)',
          data: idealLine,
          borderColor: '#8b8f9a',
          borderDash: [5,5],
          pointRadius: 0,
          tension: 0
        },
        {
          label: 'Real acumulado',
          data: realLine,
          borderColor: '#60a5fa',
          backgroundColor: 'rgba(96,165,250,0.15)',
          fill: true,
          pointRadius: 2,
          tension: 0.2
        }
      ]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { labels: { color: '#e8e9ed', font:{size:11} } }
      },
      scales: {
        x: { ticks:{ color:'#8b8f9a', font:{size:10} }, grid:{ color:'#262a34' } },
        y: { ticks:{ color:'#8b8f9a', font:{size:10} }, grid:{ color:'#262a34' } }
      }
    }
  });
}

loadState();
</script>
</body>
</html>

